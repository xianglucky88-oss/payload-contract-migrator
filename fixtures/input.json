    "tenant-a": {
      "source_schema": {
        "name": "profile",
        "version": "v1",
        "fields": {
          "id": {"type": "string", "required": true},
          "full_name": {"type": "string", "required": true},
          "status": {"type": "string", "required": false},
          "amount": {"type": "number", "required": true},
          "currency": {"type": "string", "required": false}
        }
      },
      "target_schema": {
        "name": "profile",
        "version": "v2",
        "fields": {
          "id": {"type": "string", "required": true},
          "first_name": {"type": "string", "required": true},
          "last_name": {"type": "string", "required": true},
          "status": {
            "type": "string",
            "required": true,
            "enum": ["active", "inactive", "closed"]
          },
          "amount_eur": {"type": "number", "required": true},
          "currency": {
            "type": "string",
            "required": true,
            "enum": ["USD", "EUR"]
          }
        }
      },
      "ruleset_version": "a-r3",
      "rules": [
        {"id": "keep-id", "op": "copy", "source": "id"},
        {"id": "default-currency", "op": "default", "target": "currency", "value": "USD"},
        {
          "id": "split-name",
          "op": "split",
          "source": "full_name",
          "targets": ["first_name", "last_name"],
          "delimiter": " "
        },
        {
          "id": "rename-status",
          "op": "enum_map",
          "source": "status",
          "map": {"A": "active", "I": "inactive", "C": "closed"},
          "on_unmapped": "quarantine"
        },
        {
          "id": "usd-to-eur",
          "op": "unit_convert",
          "source": "amount",
          "target": "amount_eur",
          "from_unit": "USD",
          "to_unit": "EUR",
          "unit_field": "currency",
          "rate": 0.9,
          "precision": 2
        }
      ]
    },
    "tenant-b": {
      "source_schema": {
        "name": "txn",
        "version": "v1",
