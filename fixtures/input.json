            "enum": ["new", "done", "void"]
          },
          "total_eur": {"type": "number", "required": true},
          "ccy": {"type": "string", "required": true, "enum": ["EUR"]}
        }
      },
      "ruleset_version": "b-r1",
      "rules": [
        {"id": "keep-id", "op": "copy", "source": "id"},
        {
          "id": "merge-name",
          "op": "merge",
          "sources": ["given_name", "family_name"],
          "target": "full_name",
          "delimiter": " "
        },
        {
          "id": "lower-state",
          "op": "enum_map",
          "source": "state",
          "map": {"NEW": "new", "DONE": "done", "VOID": "void"},
          "on_unmapped": "quarantine"
        },
        {
          "id": "cents-to-eur",
          "op": "unit_convert",
          "source": "total_cents",
          "target": "total_eur",
          "from_unit": "EUR",
          "to_unit": "EUR",
          "unit_field": "ccy",
          "rate": 0.01,
          "precision": 2
        }
      ]
    }
